{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "node-gtk": ["./node_modules/.node-gtk-types/node-gtk"]
    }
  },
  "include": [
    "src/**/*",
    "./node_modules/.node-gtk-types/**/*"
  ],
 
  
}
